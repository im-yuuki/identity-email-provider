# vault stack (Vaultwarden + nginx on the host) — env template
#
# Generate a complete file with random secrets:
#   scripts/00-generate-env.sh            -> writes .env (refuses overwrite unless --force)
# Or copy this template and fill the values manually.
# .env is gitignored — never commit it.
#
# docker compose interpolates .env values: escape literal $ characters as $$.

# --- Compose ---
COMPOSE_PROJECT_NAME=vault

# --- Identity provider (Authentik, on the idp host) ---
IDP_URL=https://idp.june8th.eu.org
VAULTWARDEN_SSO_CLIENT_ID=vaultwarden
VAULTWARDEN_SSO_SECRET=

# --- Vaultwarden ---
VAULTWARDEN_DOMAIN=https://vault.june8th.eu.org
VAULTWARDEN_SIGNUPS_ALLOWED=true
VAULTWARDEN_SIGNUPS_DOMAINS_WHITELIST=june8th.eu.org
# ADMIN_TOKEN: argon2id PHC string ($argon2id$...) — Vaultwarden logs an
# insecure-plaintext NOTICE otherwise. The /admin login is the PLAIN password
# the hash was generated from (print it once, don't store it in .env).
# Generate: echo -n 'your-token' | scripts/vaultwarden-hash-token.sh
# Then double the $ characters when pasting here:  $$argon2id$$v=19$$...
VAULTWARDEN_ADMIN_TOKEN=

# --- TLS ---
# The host nginx terminates TLS and proxies to the containers on 127.0.0.1.
# certbot runs in webroot mode (scripts/10-tls.sh): no downtime, the renewal
# only reloads nginx.
# LETSENCRYPT_DIR is mounted read-only into the Stalwart container, which
# serves the certificate for 465/587/993/995 itself.
LETSENCRYPT_DIR=/etc/letsencrypt
# Host path served as the ACME HTTP-01 challenge root by the host nginx.
CERTBOT_WEBROOT=/var/www/certbot
ACME_EMAIL=admin@june8th.eu.org
