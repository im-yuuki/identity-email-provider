# People + service accounts. Authelia reads uid=login, mail, cn.
# Stalwart binds as svc-mail; mail users are person entries with mail=$login@domain.

dn: uid=user1,ou=people,dc=june8th,dc=eu,dc=org
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
cn: user1
sn: user1
uid: user1
mail: user1@june8th.eu.org

dn: cn=admin,dc=june8th,dc=eu,dc=org
objectClass: top
objectClass: organizationalRole
cn: admin
description: Authelia admin login (password set via ldap passwd later)
