# RBAC groups; member = full DN. memberof overlay (enabled via
# OPENLDAP_BOOTSTRAP_MEMBEROF=true) makes memberOf appear on the user entries.

dn: cn=mail-users,ou=groups,dc=june8th,dc=eu,dc=org
objectClass: top
objectClass: groupOfNames
cn: mail-users
member: uid=user1,ou=people,dc=june8th,dc=eu,dc=org

dn: cn=admins,ou=groups,dc=june8th,dc=eu,dc=org
objectClass: top
objectClass: groupOfNames
cn: admins
member: cn=admin,dc=june8th,dc=eu,dc=org
