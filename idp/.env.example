# idp stack (Authentik + PostgreSQL + nginx on the host) — env template
#
# Generate a complete file with random secrets:
#   scripts/00-generate-env.sh            -> writes .env (refuses overwrite unless --force)
# Or copy this template and fill the values manually.
# .env is gitignored — never commit it.
#
# docker compose interpolates .env values: escape literal $ characters as $$.

# --- Compose ---
COMPOSE_PROJECT_NAME=idp

# --- Authentik + PostgreSQL ---
AUTHENTIK_TAG=2026.8.4
PG_DB=authentik
PG_USER=authentik
PG_PASSWORD=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@june8th.eu.org

# --- TLS ---
# The host nginx terminates TLS and proxies to the containers on 127.0.0.1.
# certbot runs in webroot mode (scripts/10-tls.sh): no downtime, the renewal
# only reloads nginx.
# Host path containing the Let's Encrypt live/ certificate tree. Every host
# uses --cert-name june8th.eu.org, so the path is
# /etc/letsencrypt/live/june8th.eu.org/ everywhere (the mail stack mounts it
# read-only into the Stalwart container).
LETSENCRYPT_DIR=/etc/letsencrypt
# Host path served as the ACME HTTP-01 challenge root by the host nginx.
CERTBOT_WEBROOT=/var/www/certbot
