# monitoring stack (Prometheus + Alertmanager + Grafana + node-exporter + cAdvisor + nginx on the host) — env template
#
# Generate a complete file with random secrets:
#   scripts/00-generate-env.sh            -> writes .env (refuses overwrite unless --force)
# Or copy this template and fill the values manually.
# .env is gitignored — never commit it.
#
# docker compose interpolates .env values: escape literal $ characters as $$.

# --- Compose ---
COMPOSE_PROJECT_NAME=monitoring

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://grafana.june8th.eu.org
GRAFANA_DOMAIN=grafana.june8th.eu.org

# --- Remote-write endpoint (other projects push their metrics here) ---
# Endpoint: https://metrics.june8th.eu.org/api/v1/write
# The same password must be set on the host with:
#   sudo htpasswd -cB /etc/nginx/auth/metrics.htpasswd metrics
METRICS_BASIC_AUTH_USER=metrics
METRICS_BASIC_AUTH_PASSWORD=

# --- Alertmanager ---
# Where alerts are delivered. Any generic webhook works (ntfy, Discord,
# Slack, a small relay, ...). Leave empty to disable delivery.
ALERT_WEBHOOK_URL=
# Optional: Telegram bot. Fill in both to enable it (see alertmanager.yml.tmpl).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Prometheus ---
PROMETHEUS_RETENTION=30d

# --- TLS ---
# The host nginx terminates TLS and proxies to the containers on 127.0.0.1.
# certbot issues the certificate in webroot mode from the host (see README
# "The host nginx"); the renewal hook reloads nginx.
ACME_EMAIL=admin@june8th.eu.org
