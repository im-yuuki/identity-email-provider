# idp stack (OpenLDAP + Authelia + Stalwart + Bulwark + Vaultwarden) — env template
# Generate a complete file with random secrets:
#   scripts/generate-env.sh            -> writes .env (refuses overwrite unless --force)
# Or copy this template and fill values manually. .env is gitignored — never commit it.
#
# docker compose interpolates .env values: a literal $ in a value must be
# written as $$ (e.g. argon2/pbkdf2 PHC strings, see the *HASHED keys below).

# --- OpenLDAP (osixia/openldap:2.6.x-alpha) ---
# LDAP_ADMIN_PASSWORD devs: authelia binds with it, dev LDAP users were seeded with it
LDAP_ADMIN_PASSWORD=
# bootstrap root passwords: the image ONLY reads the hashed forms.
# Generate: docker run --rm --entrypoint slappasswd osixia/openldap:2.6.15-alpha \
#   -h "{ARGON2}" -o module-path=/usr/lib/openldap -o module-load=argon2 -s '<password>'
# ...then double every $ for compose interpolation.
OPENLDAP_CONFIG_ROOT_PW_HASHED=
OPENLDAP_DATA_ROOT_PW_HASHED=

# --- Authelia ---
AUTHELIA_JWT_SECRET=            # also OIDC JW KS hmac
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_KEY=           # sqlite storage encryption

# --- Stalwart 0.16 ---
# First-boot admin: STALWART_RECOVERY_ADMIN="admin:${STALWART_ADMIN_PASSWORD}"
# Remove the env from compose.yaml once a permanent admin exists.
STALWART_ADMIN_PASSWORD=
# LDAP bind for uid=svc-mail,ou=services — stalwart ALSO holds a copy of this in
# its registry (Directory.bindSecret); rotating here requires updating it there too.
STALWART_LDAP_BIND_PASSWORD=

# --- Bulwark (webmail) ---
BULWARK_ADMIN_PASSWORD=
BULWARK_SESSION_SECRET=
BULWARK_OAUTH_SECRET=           # OIDC client "bulwark" — its pbkdf2 digest lives in authelia/configuration.yml

# --- Vaultwarden (service currently DISABLED in compose.yaml) ---
VAULTWARDEN_SSO_SECRET=         # OIDC client "vaultwarden" digest lives in authelia/configuration.yml
# ADMIN_TOKEN: argon2id PHC string ($argon2id$...) — Vaultwarden logs an
# insecure-plaintext NOTICE otherwise. The /admin login is the PLAIN password
# the hash was generated from (print it once, don't store it in .env).
# Generate: echo -n 'your-token' | scripts/vaultwarden-hash-token.sh
# Then double the $ characters when pasting here:  $$argon2id$$v=19$$...
VAULTWARDEN_ADMIN_TOKEN=

# --- Real deployment only (VPS) ---
# letsencrypt tree; dev default = ./tls (mimics the letsencrypt layout)
#LETSENCRYPT_DIR=/etc/letsencrypt
