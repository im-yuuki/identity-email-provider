# drive stack (Nextcloud + PostgreSQL + Redis + nginx on the host) — env template
#
# Generate a complete file with random secrets:
#   scripts/00-generate-env.sh            -> writes .env (refuses overwrite unless --force)
# Or copy this template and fill the values manually.
# .env is gitignored — never commit it.
#
# docker compose interpolates .env values: escape literal $ characters as $$.

# --- Compose ---
COMPOSE_PROJECT_NAME=drive

# --- Identity provider (Authentik, on the idp host) ---
IDP_URL=https://idp.june8th.eu.org
DRIVE_OIDC_CLIENT_ID=nextcloud
DRIVE_OIDC_SECRET=

# --- Nextcloud ---
DRIVE_HOSTNAME=drive.june8th.eu.org
# Comma-separated. Index 0 is the public hostname; subsequent entries are
# additional trusted_domains values Nextcloud will accept.
DRIVE_TRUSTED_DOMAINS=drive.june8th.eu.org
DRIVE_ADMIN_USER=admin
DRIVE_ADMIN_PASSWORD=

# --- PostgreSQL ---
DRIVE_DB_NAME=nextcloud
DRIVE_DB_USER=nextcloud
DRIVE_DB_PASSWORD=

# --- Redis ---
DRIVE_REDIS_PASSWORD=

# --- Per-user quota (synced from Authentik groups) ---
# Quota is managed by scripts/sync-users.sh, NOT by the user_oidc `quota`
# claim (which the app re-applies on every login and would overwrite admin
# changes). Format: human strings Nextcloud accepts ("5 GB", "200 MB", ...).
DRIVE_DEFAULT_QUOTA=5 GB
DRIVE_QUOTA_GROUPS=staff=50 GB,backup=200 GB

# Optional: require Authentik login only (users added by sync-users.sh
# still get a random password but it is never used).
DRIVE_OIDC_LOGIN_REQUIRED=true

# --- SMTP (Stalwart on the mail host) ---
# SMTP_HOST=mail.june8th.eu.org
# SMTP_PORT=465
# SMTP_SECURITY=ssltls
# SMTP_AUTHTYPE=LOGIN
# SMTP_USERNAME=noreply@june8th.eu.org
# SMTP_PASSWORD=<app-password>
# MAIL_FROM_ADDRESS=noreply
# MAIL_DOMAIN=june8th.eu.org

# --- TLS ---
# The host nginx terminates TLS and proxies to the containers on 127.0.0.1.
# certbot is run by hand (see README "The host nginx" / "TLS"); the
# certificate is issued as --cert-name june8th.eu.org.
ACME_EMAIL=admin@june8th.eu.org
