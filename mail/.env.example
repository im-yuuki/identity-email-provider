# mail stack (Stalwart + Bulwark + nginx on the host) — env template
#
# Generate a complete file with random secrets:
#   scripts/00-generate-env.sh            -> writes .env (refuses overwrite unless --force)
# Or copy this template and fill the values manually.
# .env is gitignored — never commit it.
#
# docker compose interpolates .env values: escape literal $ characters as $$.

# --- Compose ---
COMPOSE_PROJECT_NAME=mail

# --- Identity provider (Authentik, on the idp host) ---
IDP_URL=https://idp.june8th.eu.org
# OIDC application in Authentik. The client secret below must match it.
BULWARK_OAUTH_CLIENT_ID=bulwark
BULWARK_OAUTH_SECRET=
# Authentik API token (read access to core/users) used by scripts/sync-users.sh
# to create the missing Stalwart mailboxes. Create a service account in
# Authentik (Admin -> Users -> Service Accounts) and copy its token.
AUTHENTIK_API_TOKEN=

# --- Mail domain ---
MAIL_DOMAIN=june8th.eu.org
MX_HOSTNAME=mx.june8th.eu.org

# --- Stalwart 0.16 ---
# First-boot admin: STALWART_RECOVERY_ADMIN="admin:${STALWART_ADMIN_PASSWORD}"
# Remove the env from compose.yaml once a permanent admin exists.
STALWART_ADMIN_PASSWORD=

# --- Bulwark (webmail) ---
BULWARK_ADMIN_PASSWORD=
BULWARK_SESSION_SECRET=

# --- TLS ---
# The host nginx terminates TLS and proxies to the containers on 127.0.0.1.
# certbot runs in webroot mode (scripts/10-tls.sh): no downtime, the renewal
# only reloads nginx.
# LETSENCRYPT_DIR is mounted read-only into the Stalwart container, which
# serves the certificate for 465/587/993/995 itself.
LETSENCRYPT_DIR=/etc/letsencrypt
# Host path served as the ACME HTTP-01 challenge root by the host nginx.
CERTBOT_WEBROOT=/var/www/certbot
ACME_EMAIL=admin@june8th.eu.org
